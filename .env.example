# Copy to .env.local and fill in. Never commit .env.local.
# Leave an RPC blank to fall back to the chain's public endpoint (rate-limited).

# Server-only RPC overrides. Use a private RPC (e.g. Alchemy) for Robinhood mainnet in production.
RPC_URL_ROBINHOOD_MAINNET=
RPC_URL_ROBINHOOD_TESTNET=
RPC_URL_ETHEREUM=
RPC_URL_ARBITRUM=
RPC_URL_BASE=
RPC_URL_OPTIMISM=

# Optional indexed token-balance provider (not wired up yet)
INDEXER_API_KEY=

# WalletConnect / Reown project ID (public). Get one at https://cloud.reown.com.
# Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL used for metadataBase / Open Graph links (e.g. https://reclaim.example.com)
NEXT_PUBLIC_SITE_URL=

# Dev only: set to 1 to show fake scan results while building the UI
SCANNER_MOCK=

# Public source repo (footer + Safety page link)
NEXT_PUBLIC_REPO_URL=https://github.com/ola-de-fi/reclaim
